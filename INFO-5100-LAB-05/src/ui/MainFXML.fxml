<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml/1"
           xmlns="http://javafx.com/javafx/8"
           fx:controller="controller.MainFXMLController"
           stylesheets="@style.css"
           prefWidth="640.0" prefHeight="520.0">

   <children>
      <VBox styleClass="card" spacing="6" maxWidth="440.0" maxHeight="-Infinity">
         <children>
            <Label styleClass="title" text="Registration Form" />
            <Label styleClass="subtitle" text="Please fill in your details below" />

            <GridPane hgap="14" vgap="2">
               <VBox.margin>
                  <Insets top="18.0" />
               </VBox.margin>
               <columnConstraints>
                  <ColumnConstraints minWidth="60.0" prefWidth="60.0" />
                  <ColumnConstraints hgrow="ALWAYS" />
               </columnConstraints>
               <children>
                  <Label styleClass="field-label" text="Name" GridPane.rowIndex="0" />
                  <TextField fx:id="nameTextField" promptText="Full name"
                             GridPane.columnIndex="1" GridPane.rowIndex="0" />
                  <Label fx:id="nameErrorLabel" styleClass="error-label" minHeight="18.0"
                         GridPane.columnIndex="1" GridPane.rowIndex="1" />

                  <Label styleClass="field-label" text="Age" GridPane.rowIndex="2" />
                  <Spinner fx:id="ageSpinner" editable="true" maxWidth="Infinity"
                           GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <Label fx:id="ageErrorLabel" styleClass="error-label" minHeight="18.0"
                         GridPane.columnIndex="1" GridPane.rowIndex="3" />

                  <Label styleClass="field-label" text="Email" GridPane.rowIndex="4" />
                  <TextField fx:id="emailTextField" promptText="name@example.com"
                             GridPane.columnIndex="1" GridPane.rowIndex="4" />
                  <Label fx:id="emailErrorLabel" styleClass="error-label" minHeight="18.0"
                         GridPane.columnIndex="1" GridPane.rowIndex="5" />
               </children>
            </GridPane>

            <Button text="Submit" onAction="#submit" maxWidth="Infinity">
               <VBox.margin>
                  <Insets top="14.0" />
               </VBox.margin>
            </Button>
         </children>
      </VBox>
   </children>
</StackPane>